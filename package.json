{
  "name": "junos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:web": "npm run dev -w @junos/web",
    "dev:daemon": "npm run start -w @junos/daemon",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b apps/daemon apps/hermes-shim packages/shared && tsc -b apps/web",
    "lint": "oxlint",
    "test": "npm test --workspaces --if-present",
    "backup:verify": "node apps/daemon/src/backup-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3"
  }
}
