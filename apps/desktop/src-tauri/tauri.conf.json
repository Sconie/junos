{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JunOS",
  "version": "0.1.0",
  "identifier": "dev.junos.desktop",
  "build": {
    "frontendDist": "http://127.0.0.1:4777"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JunOS",
        "url": "http://127.0.0.1:4777",
