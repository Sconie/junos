# Copy to /etc/junos-hermes-shim.env, mode 600. Never commit the real file.
# The same value as Hermes's API_SERVER_KEY (at least 16 characters).
HERMES_API_KEY=
# This VPS's Tailscale address (100.x.y.z), or 127.0.0.1 behind an SSH tunnel. Never 0.0.0.0.
JUNOS_SHIM_HOST=127.0.0.1
JUNOS_SHIM_PORT=8650
HERMES_API_URL=http://127.0.0.1:8642
JUNOS_SHIM_MEMORY_DIR=/opt/data/memories
JUNOS_SHIM_SKILLS_DIR=/opt/data/skills
JUNOS_SHIM_STATE_DIR=/var/lib/junos-hermes-shim
# Optional: a JSON-lines log of Hermes's conversation, to mirror Telegram.
# JUNOS_SHIM_LOG_FILE=/opt/data/logs/conversation.jsonl
# Optional: ranges besides loopback that may call the approval hooks (Hermes in Docker).
# JUNOS_SHIM_HOOK_CIDRS=172.16.0.0/12
